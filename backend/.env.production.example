# Copy to .env.production and fill in real values. Never commit .env.production.

# Database
DATABASE_URL="postgresql://postgres:<PASSWORD>@postgres:5432/chat_app?schema=public"

# Redis
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-different-strong-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis password (must match docker-compose.prod.yml REDIS_PASSWORD)
REDIS_PASSWORD="replace-with-strong-redis-password"

# App
PORT=3001
NODE_ENV=production
FRONTEND_URL="https://yourdomain.com"
