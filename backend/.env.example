# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chat_app?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — use long random strings in production (openssl rand -base64 64)
JWT_SECRET="change-me-must-be-at-least-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-must-be-32-chars-long!"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
